{
  "name": "aeternum",
  "version": "0.1.0",
  "description": "AETERNUM — juego de mesa y aventura de rol",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "datos": "node tools/generar-datos.js",
    "mapa": "node tools/generar-mapa.js",
    "simular": "node tools/simular.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "juego",
    "cartas",
    "turnos"
  ],
  "author": "Chu-Gi-Oh!YT",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chugioh.aeternum",
    "productName": "AETERNUM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AETERNUM",
      "artifactName": "AETERNUM-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AETERNUM-portable-${version}.${ext}"
    }
  }
}
